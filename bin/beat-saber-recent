#!/usr/bin/env bash
# steam-frame-utils: the songs Beat Saber played in its recent launches,
# in order, from Unity's Player.log and Player-prev.log in the game's
# Proton prefix and from the songs recorded by the launch hook below.
#
# Usage:  beat-saber-recent [-n N | --all]
#         beat-saber-recent --record
#         beat-saber-recent --install-hook
#
# Beat Saber writes a timestamped line when a level starts. Unity keeps
# only two logs, the running launch's and the one before, so two
# launches that played nothing push every song out of reach;
# PlayerData.dat has the play counts for every song but no dates.
# --record copies the songs in the two logs into
# ~/.local/state/steam-frame-utils/beat-saber-songs.tsv, keeping what is
# there, and the plain run shows that file and the two logs together,
# the last N launches that played a song (default 2). To record every
# launch, set this in the game's Properties > Launch Options in Steam,
# which runs the hook before and after the game, so a launch is kept
# even when its own hook was missed:
#
#   ~/steam-frame-utils/bin/beat-saber-recent --record; %command%; ~/steam-frame-utils/bin/beat-saber-recent --record
#
# --install-hook sets that for you, with this script's full path,
# through the running Steam client: on the Frame, Steam runs with its
# Chromium debug port open on 127.0.0.1:8080 for the VR shell, and the
# client's own API sets a game's launch options and saves them. Launch
# options that are already set are left alone and shown, since there is
# no telling what to keep; the client's file, localconfig.vdf, can't be
# edited instead while Steam runs, as it writes its copy back over it.
#
# A line means the song started, not that it was finished. Custom maps
# are shown by their name, with (custom); Valve's and Beat Games' own by
# their level id, which is the title without spaces.

set -euo pipefail

if [[ -n ${CONTAINER_ID:-} || -e /run/.containerenv ]]; then
  exec distrobox-host-exec "$0" "$@"
fi

usage() { sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; }
die() { echo "beat-saber-recent: $*" >&2; exit 1; }

mode=show
n=2
while (( $# )); do
  case $1 in
    -h|--help) usage; exit 0 ;;
    --record) mode=record ;;
    --install-hook) mode=install ;;
    --all) n=0 ;;
    -n) [[ ${2:-} =~ ^[1-9][0-9]*$ ]] || die "-n takes a number of launches"; n=$2; shift ;;
    -n[1-9]*) n=${1#-n} ;;
    *) die "unknown argument: $1" ;;
  esac
  shift
done

DIR=$HOME/.local/share/Steam/steamapps/compatdata/620980/pfx/drive_c/users/steamuser/AppData/LocalLow/Hyperbolic\ Magnetism/Beat\ Saber
HIST=$HOME/.local/state/steam-frame-utils/beat-saber-songs.tsv
[[ -d $DIR ]] || die "no Beat Saber data at $DIR"

# One line per song start, tab-separated: the launch's key, which is its
# first song's time, so the same log gives the same lines whenever it is
# read; the song's time; the log's own words.
#   [2026-10-28T18:13:43] custom_level_32dff (Queencard - eurnkung) [BeatmapLevel: -1/...]
#   [2026-10-28T18:16:57] Overkill [BeatmapLevel: 0/BeatmapLevelData: 1]
songs() {
  local log launch line
  for log in "$DIR/Player-prev.log" "$DIR/Player.log"; do
    [[ -f $log ]] || continue
    launch=
    while IFS= read -r line; do
      [[ -n $launch ]] || launch=${line%%$'\t'*}
      printf '%s\t%s\n' "$launch" "$line"
    done < <(sed -nE 's/^\[([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2})\] (.*) \[BeatmapLevel:.*$/\1\t\2/p' "$log")
  done
}

if [[ $mode == install ]]; then
  me=$(realpath "$0")
  python3 -I - "$me --record; %command%; $me --record" <<'EOF'
import base64, json, os, socket, struct, sys, urllib.request

hook = sys.argv[1]
appid = 620980
port = 8080

def by_hand(why):
    print(f"beat-saber-recent: {why}; set the game's Launch Options in Steam by hand to:\n  {hook}", file=sys.stderr)
    sys.exit(1)

# The client's pages, one per CEF window; SharedJSContext is the one
# with the stores and SteamClient.
try:
    targets = json.load(urllib.request.urlopen(f"http://127.0.0.1:{port}/json", timeout=5))
    target = next(t for t in targets if t["title"] == "SharedJSContext")
except (OSError, StopIteration, ValueError):
    by_hand(f"Steam's debug port isn't open on 127.0.0.1:{port}")

# A WebSocket by hand, to keep to the standard library.
path = target["webSocketDebuggerUrl"].split(f":{port}", 1)[1]
sock = socket.create_connection(("127.0.0.1", port), timeout=15)
key = base64.b64encode(os.urandom(16)).decode()
sock.sendall(f"GET {path} HTTP/1.1\r\nHost: 127.0.0.1:{port}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
             f"Sec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n".encode())
buf = b""
while b"\r\n\r\n" not in buf:
    buf += sock.recv(4096)
head, buf = buf.split(b"\r\n\r\n", 1)
if b" 101 " not in head.split(b"\r\n", 1)[0]:
    by_hand("the debug port refused the WebSocket")

def send(obj):
    data = json.dumps(obj).encode()
    n = len(data)
    size = bytes([0x80 | n]) if n < 126 else b"\xfe" + struct.pack(">H", n) if n < 65536 else b"\xff" + struct.pack(">Q", n)
    mask = os.urandom(4)
    sock.sendall(b"\x81" + size + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(data)))

def read(n):
    global buf
    while len(buf) < n:
        buf += sock.recv(65536)
    out, buf = buf[:n], buf[n:]
    return out

def recv():
    b0, b1 = read(2)
    n = b1 & 0x7F
    if n == 126:
        n = struct.unpack(">H", read(2))[0]
    elif n == 127:
        n = struct.unpack(">Q", read(8))[0]
    if b1 & 0x80:
        read(4)
    return json.loads(read(n))

js = """(async () => {
  const id = %d, hook = %s, tick = () => new Promise(r => setTimeout(r, 100));
  for (let i = 0; i < 50 && !appDetailsStore.GetAppDetails(id); i++) {
    if (!i) appDetailsStore.RequestAppDetails(id);
    await tick();
  }
  const details = appDetailsStore.GetAppDetails(id);
  if (!details) return { error: "the client has no details for app " + id };
  const was = details.strLaunchOptions;
  if (was !== "") return { was };
  await SteamClient.Apps.SetAppLaunchOptions(id, hook);
  for (let i = 0; i < 50 && appDetailsStore.GetAppDetails(id).strLaunchOptions !== hook; i++) await tick();
  return { was, now: appDetailsStore.GetAppDetails(id).strLaunchOptions };
})()""" % (appid, json.dumps(hook))
send({"id": 1, "method": "Runtime.evaluate", "params": {"expression": js, "awaitPromise": True, "returnByValue": True}})
while True:
    reply = recv()
    if reply.get("id") == 1:
        break
result = reply.get("result", {}).get("result", {}).get("value")
if not isinstance(result, dict):
    by_hand("the client's answer made no sense: " + json.dumps(reply)[:300])
if "error" in result:
    by_hand(result["error"])
if "now" not in result:
    if "beat-saber-recent" in result["was"] and "--record" in result["was"]:
        print(f"launch options already have the hook: {result['was']}")
        sys.exit(0)
    by_hand(f"launch options are set to '{result['was']}', left as they are")
if result["now"] != hook:
    by_hand(f"the client did not take the launch options (it has '{result['now']}')")
print(f"launch options set to: {hook}")
EOF
  exit
fi

if [[ $mode == record ]]; then
  mkdir -p "${HIST%/*}"
  tmp=$(mktemp "$HIST.XXXXXX")
  { [[ -f $HIST ]] && cat "$HIST"; songs; } | sort -u > "$tmp"
  command mv -f "$tmp" "$HIST"
  exit 0
fi

mapfile -t lines < <({ [[ -f $HIST ]] && cat "$HIST"; songs; } | sort -u)
if (( ! ${#lines[@]} )); then
  echo "no songs: none in the Unity logs, none recorded (see --help)"
  exit 0
fi

launches=()
for line in "${lines[@]}"; do
  key=${line%%$'\t'*}
  if (( ! ${#launches[@]} )) || [[ ${launches[-1]} != "$key" ]]; then launches+=("$key"); fi
done
m=${#launches[@]}
start=${launches[n && n < m ? m - n : 0]}

showing=0 prev=
for line in "${lines[@]}"; do
  IFS=$'\t' read -r key at name <<< "$line"
  (( showing )) || [[ $key == "$start" ]] || continue
  showing=1
  if [[ $key != "$prev" ]]; then
    [[ -z $prev ]] || echo
    echo "Session of ${key:0:10}"
    prev=$key
  fi
  if [[ $name =~ ^custom_level_[0-9a-f]+\ \((.*)\)$ ]]; then name="${BASH_REMATCH[1]} (custom)"; fi
  echo "${at:0:10} ${at:11:5}  $name"
done
