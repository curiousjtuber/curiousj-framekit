@@ -299,6 +301,16 @@
     m_configGroup.writeEntry("PreventSessionLock", enabled);
 }
 
+bool RdpHostPreferences::embeddedCursor() const
+{
+    return m_configGroup.readEntry("embeddedCursor", Settings::embeddedCursor());
+}
+
+void RdpHostPreferences::setEmbeddedCursor(bool enabled)
+{
+    m_configGroup.writeEntry("embeddedCursor", enabled);
+}
