# WayVR (https://github.com/wayvr-org/wayvr), built for ~/.local on the
# Steam Frame host: apps and desktops as panels around you in SteamVR.
# Upstream's aarch64 AppImage is the simple install
# (docs/simple-installs.md) and runs as it is; this package exists for
# what the AppImage can't be given.
#
# wvr-screen-res.patch: WayVR's one virtual output is a constant
# 2560x1440, which caps every panel; the patch makes it a config key,
# wvr_screen_res, so that a remote desktop of two monitors fits one
# panel. wayvr-bundled-beside-exe.patch: outside an AppImage WayVR
# finds xwayland-satellite on PATH alone, and SteamVR starts it by the
# binary's path with no PATH of ours; the patch looks beside the
# executable, where this package puts a link to it.
# wayvr-anchor-before-spawn.patch: an app or the dashboard opened before
# the overlays were ever shown landed on the floor, half under it; the
# patch puts WayVR's anchor in front of the headset first.
#
# xwayland-satellite itself is the kit's package of that name, which
# the catalog's wayvr item needs and installs first. It isn't in
# depends: makepkg checks those against the host's packages, which
# don't have it, and would refuse to build. Without it WayVR runs and
# X11 apps in its panels don't.
#
# The package also holds wayvrctl, WayVR's command-line client, built
# from the same commit: the two speak a protocol that changes with the
# source, so a wayvrctl from another build may not connect.
#
# No tagged release has an aarch64 build or the Frame's controller
# bindings, so the source is a commit of main, pinned. Built without
# the openxr feature: SteamVR has no EXTX_overlay, so WayVR on the
# Frame is always on OpenVR, and without it the binary needs no OpenXR
# loader, which SteamOS doesn't have. OpenVR's library is the host's,
# /usr/lib/libopenvr_api.so, from SteamVR's own package.
#
# cargo is mise's or rustup's, not a host package, so makedepends can't
# name it: cjf install puts mise's shims on PATH for the build, and
# build() stops with a line saying so when there is none. cargo
# downloads the crates Cargo.lock pins by checksum
# (--locked), and the git dependencies they pin by commit, into
# ~/.cargo, during prepare(); the build needs the network for that
# step alone.
#
# Everything goes under ~/.local/lib/wayvr, with ~/.local/bin/wayvr
# and ~/.local/bin/wayvrctl as links. WayVR registers itself with
# SteamVR by the path of its own executable, so SteamVR starts this
# build once it has run; the AppImage, if it is still installed,
# registers its own path when it runs, and the last one run wins. The
# package is for this one user on this one device.
#
# Build and install (on the Frame, about ten minutes):
#   cjf install wayvr
# or by hand, in this directory, with cargo on PATH:
#   makepkg -f && pacman-home -U wayvr-*.pkg.tar.zst
#
# For a newer WayVR: set _commit and pkgver (git rev-list --count
# gives the r), make sure the three patches still apply
# (docs/patches.md says where each stands), and build. A change to a
# patch needs its b2sum here and a pkgrel bump, which is what tells
# pacman-home the install is outdated.

pkgname=wayvr
# As WayVR names itself in its log: Cargo.toml's version, the commit's
# number on main and its id.
pkgver=26.8.0.r193.gcc8843a
pkgrel=4
pkgdesc="WayVR built for ~/.local on the Steam Frame host, with a virtual output of any size, and wayvrctl"
arch=('aarch64' 'x86_64')
url='https://github.com/wayvr-org/wayvr'
license=(GPL-3.0-only)
depends=(
  alsa-lib
  dav1d
  dbus
  libinput
  libpipewire
  libx11
  libxcb
  libxext
  libxkbcommon
  libxkbcommon-x11
  libxrandr
  systemd-libs
  vulkan-icd-loader
)
makedepends=(clang cmake git pkgconf)
options=(!debug !lto)
_commit=cc8843a95a8aaf6adcd9db21b30aaf1438372ef0
source=(
  wayvr::git+https://github.com/wayvr-org/wayvr.git#commit=$_commit
  wvr-screen-res.patch
  wayvr-bundled-beside-exe.patch
  wayvr-anchor-before-spawn.patch
)
# The git source is pinned by commit above, which is the check.
b2sums=('SKIP'
        '5182543027716c6ddce913496897a389535fa74dff45fb7479ad35a139d664a34c4f74145f2bea7225f677c053f9492e4a182da8d11e60b1eb525c9508e537dc'
        '5eaf73bd53f7ad21bc12a5342e8c349a135857781e2f6b7fc2ba37b2c1d61964507b93c389e8375711dc1462101d6b96da76506885227cc6994707affaa5c67e'
        '4c9ac6bf65df81221c346242b1ccaa63eb9451c1154a84ce6a06a13e863b6c6335603a3eec8ae8189a40ea0b84fa0346faee74da88edde709ed7e52152a18165')

_prefix=$HOME/.local
_home=$_prefix/lib/wayvr
# openxr left out; the rest are upstream's defaults.
_features=openvr,osc,wayland,whisper,x11

_need_cargo() {
  command -v cargo >/dev/null && return
  echo "no cargo on PATH: this package builds with Rust, which SteamOS doesn't ship; install it with mise (mise use -g rust) or rustup, then build again" >&2
  return 1
}

prepare() {
  _need_cargo
  cd wayvr
  patch -p1 --forward < "$srcdir/wvr-screen-res.patch"
  patch -p1 --forward < "$srcdir/wayvr-bundled-beside-exe.patch"
  patch -p1 --forward < "$srcdir/wayvr-anchor-before-spawn.patch"
  cargo fetch --locked
}

build() {
  _need_cargo
  cd wayvr/wayvr
  cargo build --release --frozen --no-default-features --features "$_features"
  cd ../wayvrctl
  cargo build --release --frozen
}

package() {
  install -Dm755 wayvr/target/release/wayvr "$pkgdir$_home/bin/wayvr"
  install -Dm755 wayvr/target/release/wayvrctl "$pkgdir$_home/bin/wayvrctl"
  # Beside wayvr, where the second patch has it look: the
  # xwayland-satellite package's program.
  ln -s "$_prefix/bin/xwayland-satellite" "$pkgdir$_home/bin/xwayland-satellite"
  install -Dm644 wayvr/LICENSE "$pkgdir$_home/share/licenses/wayvr/LICENSE"
  install -Dm644 wayvr/dash-frontend/assets/dashboard/wayvr_dashboard.png \
    "$pkgdir$_home/share/icons/wayvr.png"

  # Links, not launchers: WayVR reads its own path from /proc, which
  # names the binary whichever way it was started.
  mkdir -p "$pkgdir$_prefix/bin" "$pkgdir$_prefix/share/applications"
  ln -s "$_home/bin/wayvr" "$pkgdir$_prefix/bin/wayvr"
  ln -s "$_home/bin/wayvrctl" "$pkgdir$_prefix/bin/wayvrctl"

  # A menu entry of its own name: Gear Lever's, for the AppImage, is
  # wayvr.desktop.
  cat > "$pkgdir$_prefix/share/applications/wayvr-home.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=WayVR (kit build)
Comment=Your way to enjoy VR on Linux
Exec=$_home/bin/wayvr
Icon=$_home/share/icons/wayvr.png
Terminal=false
Categories=Utility;X-WiVRn-VR;
DESKTOP
}
